---
import { site } from '../data/site';

const isHome = Astro.url.pathname === '/';
const navItems = site.nav.map((item) => ({
  ...item,
  href: item.href.startsWith('#') && !isHome ? `/${item.href}` : item.href
}));
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`Jrxh 首页 — ${site.domain}，${site.status}`}>
      <span class="brand-mark">
        <span class="brand-name">jrxh</span><span class="brand-tld">.top</span>
      </span>
      <span class="status-dot" aria-hidden="true"></span>
    </a>

    <div class="header-right">
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="切换到浅色主题"
        title="切换主题"
      >
        <svg class="theme-icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg class="theme-icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
      </button>

      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="打开导航"
      >
        <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
      </button>

      <nav class="site-nav" id="site-nav" aria-label="主导航">
        <ul class="nav-list">
          {
            navItems.map((item) => (
              <li>
                <a class="nav-link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="nav-mail" href={`mailto:${site.email}`}>{site.email}</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--hairline-soft);
    transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .site-header.is-scrolled {
    background: var(--bg);
    border-bottom-color: var(--hairline);
  }

  /* 滚动进度：1px 橙色线，像仪表刻度 */
  .site-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--spark);
    transform: scaleX(var(--scroll-progress, 0));
    transform-origin: left;
    pointer-events: none;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 72px;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .theme-toggle {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    color: var(--muted);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .theme-toggle:hover {
    color: var(--spark);
    border-color: var(--spark-line);
    background: var(--spark-soft);
  }

  .theme-icon {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-sun {
    display: none;
  }

  .theme-toggle[data-theme='light'] .icon-moon {
    display: none;
  }

  .theme-toggle[data-theme='light'] .icon-sun {
    display: block;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-block: 6px;
  }

  .brand-mark {
    display: inline-flex;
    align-items: flex-start;
    font-family: var(--font-display);
    font-size: 21px;
    line-height: 1;
    letter-spacing: 0.01em;
    font-weight: 600;
  }

  .brand-name {
    color: var(--text);
  }

  .brand-tld {
    margin-left: 2px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--spark);
    transform: translateY(-7px);
  }

  .status-dot {
    position: relative;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green);
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid var(--green);
    animation: breathe 3.2s var(--ease) infinite;
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.7);
    }
    35% {
      opacity: 0.55;
      transform: scale(1);
    }
    70% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding-block: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--spark);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.26s var(--ease);
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  .nav-mail {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--dim);
    padding-block: 6px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .nav-mail:hover {
    color: var(--cyan);
    border-bottom-color: var(--cyan-line);
  }

  .nav-toggle {
    display: none;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    color: var(--muted);
  }

  .nav-toggle-bars {
    display: grid;
    gap: 5px;
    width: 16px;
  }

  .nav-toggle-bars i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.24s var(--ease), opacity 0.24s var(--ease);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bars i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bars i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (max-width: 760px) {
    .header-inner {
      height: 64px;
    }

    .header-right {
      gap: 10px;
    }

    .theme-toggle {
      width: 38px;
      height: 38px;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: grid;
      gap: 4px;
      padding: 8px 24px 18px;
      background: var(--bg);
      border-bottom: 1px solid var(--hairline);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition: opacity 0.24s var(--ease), transform 0.24s var(--ease),
        visibility 0.24s;
    }

    .site-nav.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .nav-list {
      display: grid;
      gap: 0;
    }

    .nav-link {
      display: block;
      padding-block: 12px;
      border-bottom: 1px solid var(--hairline-soft);
      font-size: 13px;
      letter-spacing: 0.08em;
      color: var(--text);
    }

    .nav-link::after {
      display: none;
    }

    .nav-mail {
      margin-top: 12px;
      justify-self: start;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot::after {
      animation: none;
      opacity: 0.45;
      transform: scale(1);
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');

  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);

      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      header.style.setProperty('--scroll-progress', progress.toFixed(4));
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
      nav.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  /* ---------- 主题切换 ---------- */

  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeMedia = window.matchMedia('(prefers-color-scheme: light)');
  const themeMeta = document.querySelector('meta[name="theme-color"]');

  if (!document.documentElement.dataset.theme) {
    document.documentElement.dataset.theme = themeMedia.matches ? 'light' : 'dark';
  }

  const syncTheme = () => {
    const isLight = document.documentElement.dataset.theme === 'light';

    if (themeToggle) {
      themeToggle.dataset.theme = isLight ? 'light' : 'dark';
      themeToggle.setAttribute('aria-label', isLight ? '切换到深色主题' : '切换到浅色主题');
      themeToggle.title = isLight ? '切换到深色主题' : '切换到浅色主题';
    }

    if (themeMeta) {
      themeMeta.setAttribute('content', isLight ? '#f4f1ea' : '#0a0c10');
    }
  };

  const setTheme = (theme: 'light' | 'dark') => {
    document.documentElement.dataset.theme = theme;
    syncTheme();
  };

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      try {
        localStorage.setItem('jrxh-theme', next);
      } catch {
        // 隐私模式下写入失败时，本次切换仍然生效
      }
      setTheme(next);
    });
  }

  themeMedia.addEventListener('change', (event) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem('jrxh-theme');
    } catch {
      stored = null;
    }
    if (stored) return;
    setTheme(event.matches ? 'light' : 'dark');
  });

  syncTheme();
</script>
