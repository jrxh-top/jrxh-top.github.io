---
import type { Project } from '../data/site';

interface Props {
  project: Project;
  delay?: number;
}

const { project, delay = 0 } = Astro.props;
const levels = [1, 2, 3];
---

<article class="project-row" data-reveal style={`--reveal-delay: ${delay}ms`}>
  <div class="row-index">
    <span class="idx">{project.index}</span>
    <span class="idx-label" aria-hidden="true">project</span>
  </div>

  <div class="row-main">
    <h3 class="project-name">{project.name}</h3>
    <p class="project-summary">{project.summary}</p>
    <ul class="project-tags" aria-label="技术标签">
      {project.tags.map((tag) => <li class="project-tag">{tag}</li>)}
    </ul>
  </div>

  <dl class="row-meta">
    <div class="meta-item">
      <dt>角色</dt>
      <dd>{project.role}</dd>
    </div>
    <div class="meta-item">
      <dt>结果</dt>
      <dd>{project.result}</dd>
    </div>
  </dl>

  <div class="row-side">
    <span class="spark-level" aria-label={`火花等级 ${project.sparkLevel} / 3`}>
      <span class="spark-label" aria-hidden="true">spark</span>
      {
        levels.map((level) => (
          <i class:list={['spark-bar', { 'is-on': level <= project.sparkLevel }]} aria-hidden="true" />
        ))
      }
    </span>
    <a class="project-link" href={project.url}>
      查看项目
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  /* 编辑排版式项目行：编号 / 名称 / 事实 / 动作 */
  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1.6fr) minmax(0, 0.9fr) 120px;
    grid-template-areas: 'idx main meta side';
    align-items: start;
    gap: 16px 28px;
    padding: 28px 12px 32px;
    margin-inline: -12px;
    border-bottom: 1px solid var(--hairline-soft);
    transition: background-color 0.3s var(--ease);
  }

  .project-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--spark);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.3s var(--ease);
  }

  .project-row:hover {
    background: var(--hover-row);
  }

  .project-row:hover::before {
    transform: scaleY(1);
  }

  .row-index {
    grid-area: idx;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 10px;
  }

  .idx {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--spark);
  }

  .idx-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .row-main {
    grid-area: main;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .project-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 1.95rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.015em;
    text-wrap: balance;
  }

  .project-summary {
    max-width: 42ch;
    font-size: 13px;
    line-height: 1.85;
    color: var(--muted);
    text-wrap: pretty;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 2px;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--text-soft-3);
  }

  .project-tag::before {
    content: '·';
    margin-right: 7px;
    color: var(--spark);
  }

  .project-tag:first-child::before {
    content: '';
    margin-right: 0;
  }

  .row-meta {
    grid-area: meta;
    display: grid;
    gap: 12px;
    align-content: start;
    margin: 0;
    padding-top: 8px;
  }

  .meta-item {
    display: grid;
    gap: 3px;
  }

  .meta-item dt {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .meta-item dd {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--text-soft-2);
  }

  .row-side {
    grid-area: side;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    gap: 22px;
    align-self: stretch;
    padding-top: 10px;
  }

  .spark-level {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .spark-label {
    margin-right: 5px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .spark-bar {
    display: block;
    width: 14px;
    height: 3px;
    background: var(--spark-bar-off);
  }

  .spark-bar.is-on {
    background: var(--spark);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--spark);
    border-bottom: 1px solid transparent;
    padding-bottom: 3px;
    transition: gap 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .project-link:hover {
    gap: 10px;
    border-color: var(--spark-line);
  }

  .project-link span {
    font-size: 11px;
  }

  @media (max-width: 980px) {
    .project-row {
      grid-template-columns: 48px minmax(0, 1fr) auto;
      grid-template-areas:
        'idx main main'
        'idx meta side';
      gap: 20px 24px;
    }

    .row-side {
      align-items: flex-end;
      gap: 14px;
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .project-row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'idx'
        'main'
        'meta'
        'side';
      gap: 16px;
      padding: 24px 0 26px;
      margin-inline: 0;
    }

    .row-index {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
      padding-top: 0;
    }

    .row-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      padding-top: 0;
    }

    .row-side {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-top: 0;
      gap: 16px;
    }

    .project-row::before {
      top: 4px;
      bottom: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-row::before {
      transition: none;
    }
  }
</style>
