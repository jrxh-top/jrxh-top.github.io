---
import { site, type TermSegment } from '../data/site';
import { quickCommands } from '../data/commands';

const ps1 = `${site.promptUser}@${site.promptHost}:~$`;
---

<section class="terminal" id="terminal" aria-label="星火控制台终端，可运行命令">
  <div class="term-bar">
    <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="term-title">{site.promptUser}@{site.promptHost} — zsh</span>
    <span class="term-badge" aria-hidden="true">tty1</span>
  </div>

  <div class="term-screen">
    <div class="term-output" id="term-output" aria-live="polite" aria-atomic="false" aria-busy="false">
      {
        site.bootLines.map((line) =>
          line.command ? (
            <div class="line line-cmd">
              <span class="ps1">{ps1}</span>
              <span class="cmd-text">{line.command}</span>
            </div>
          ) : line.gap ? (
            <div class="line line-gap" aria-hidden="true" />
          ) : (
            <div class="line line-out">
              {(line.segments ?? []).map((s) => (
                <span class={`seg seg-${s.tone ?? 'text'}`}>{s.text}</span>
              ))}
            </div>
          )
        )
      }
    </div>

    <div class="term-quick">
      <span class="quick-label" aria-hidden="true">快速命令</span>
      <div class="quick-list">
        {
          quickCommands.map((cmd) => (
            <button class="quick-btn" type="button" data-command={cmd.name}>
              {cmd.hint}
            </button>
          ))
        }
      </div>
    </div>

    <button
      class="term-toggle"
      id="term-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="term-form"
    >
      <span aria-hidden="true">⌨</span> 输入命令
    </button>

    <form class="term-form" id="term-form" autocomplete="off">
      <label class="sr-only" for="term-input">终端命令输入框</label>
      <span class="ps1" aria-hidden="true">
        <span class="ps1-user">{site.promptUser}</span>@<span class="ps1-host">{site.promptHost}</span>:~$
      </span>
      <span class="term-caret" aria-hidden="true"></span>
      <input
        class="term-input"
        id="term-input"
        name="command"
        type="text"
        inputmode="text"
        enterkeyhint="go"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        placeholder="输入 help 看看能做什么"
      />
    </form>
  </div>
</section>

<style>
  .terminal {
    /* 终端始终保持深色，作为页面的固定"控制台"材质 */
    --bg-panel: #0e1116;
    --text: #f5f7fa;
    --muted: #8b93a7;
    --dim: #737d92;
    --faint: #5b6478;
    --spark: #ff6a3d;
    --spark-soft: rgba(255, 106, 61, 0.12);
    --spark-line: rgba(255, 106, 61, 0.45);
    --cyan: #6ee7f9;
    --green: #34d399;
    --hairline: rgba(255, 255, 255, 0.1);
    --hairline-soft: rgba(255, 255, 255, 0.055);
    color-scheme: dark;
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--bg-panel);
    box-shadow: 0 30px 60px -46px rgba(0, 0, 0, 0.95);
    overflow: hidden;
    font-family: var(--font-mono);
  }

  .terminal::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--spark);
    opacity: 0.6;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 38px;
    padding-inline: 14px;
    border-bottom: 1px solid var(--hairline-soft);
  }

  .term-dots {
    display: inline-flex;
    gap: 5px;
  }

  .term-dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #333a47;
  }

  .term-dots i:first-child {
    background: #4a3330;
  }

  .term-dots i:nth-child(2) {
    background: #46412e;
  }

  .term-dots i:last-child {
    background: #2f4038;
  }

  .term-title {
    flex: 1;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--dim);
  }

  .term-badge {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: #454c5c;
    text-transform: uppercase;
  }

  .term-screen {
    display: flex;
    flex-direction: column;
    padding: 18px 18px 16px;
  }

  .term-output {
    height: 214px;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: #2a303c transparent;
    padding-right: 6px;
    overscroll-behavior: contain;
  }

  .term-output :global(.line) {
    font-size: 12.5px;
    line-height: 1.95;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .term-output :global(.line-gap) {
    height: 9px;
  }

  .term-output :global(.line-cmd) {
    margin-top: 2px;
  }

  .term-output :global(.line-out) {
    color: #b8c0d0;
  }

  .term-output :global(.seg-accent) {
    color: var(--spark);
  }

  .term-output :global(.seg-cyan) {
    color: var(--cyan);
  }

  .term-output :global(.seg-green) {
    color: var(--green);
  }

  .term-output :global(.seg-dim) {
    color: #4f5668;
  }

  .term-output :global(.seg-muted) {
    color: var(--muted);
  }

  .term-output :global(.seg-text) {
    color: var(--text);
  }

  /* 命令执行时由 JS 创建的行，需要全局样式才能命中 */
  .term-output :global(.ps1) {
    color: var(--green);
    margin-right: 8px;
    white-space: nowrap;
  }

  .term-output :global(.cmd-text) {
    color: var(--text);
  }

  .ps1 {
    color: var(--green);
    margin-right: 8px;
    white-space: nowrap;
  }

  .ps1-user {
    color: var(--green);
  }

  .ps1-host {
    color: var(--spark);
  }

  .cmd-text {
    color: var(--text);
  }

  .term-quick {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline-soft);
  }

  .quick-label {
    display: block;
    margin-bottom: 8px;
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .quick-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .quick-btn {
    padding: 5px 9px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--muted);
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease),
      background-color 0.18s var(--ease);
  }

  .quick-btn:hover {
    color: var(--text);
    border-color: var(--spark-line);
    background: var(--spark-soft);
  }

  .quick-btn:active {
    background: rgba(255, 106, 61, 0.18);
  }

  .term-form {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline-soft);
  }

  .term-input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 2px 0;
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text);
    caret-color: var(--spark);
  }

  .term-input:focus {
    outline: none;
  }

  .term-input::placeholder {
    color: var(--faint);
  }

  .term-form.is-empty .term-input {
    caret-color: transparent;
  }

  .term-caret {
    flex: none;
    width: 7px;
    height: 14px;
    margin-right: 7px;
    background: var(--spark);
    animation: caret-blink 1s steps(1, end) infinite;
  }

  .term-form:not(.is-empty) .term-caret {
    visibility: hidden;
  }

  .term-form:focus-within .term-caret {
    box-shadow: 0 0 12px rgba(255, 106, 61, 0.55);
  }

  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .term-toggle {
    display: none;
    width: 100%;
    margin-top: 12px;
    padding: 10px;
    border: 1px dashed var(--hairline);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }

  .term-toggle:hover {
    color: var(--text);
    border-color: var(--spark-line);
  }

  @media (max-width: 640px) {
    .term-screen {
      padding: 14px 14px 14px;
    }

    .term-output {
      height: auto;
      max-height: 240px;
      min-height: 0;
    }

    .term-output :global(.line) {
      font-size: 12px;
      line-height: 1.9;
    }

    .term-toggle {
      display: block;
    }

    .term-form {
      display: none;
    }

    .terminal.input-open .term-form {
      display: flex;
    }

    .terminal.input-open .term-toggle {
      border-style: solid;
      color: var(--dim);
    }

    .term-quick {
      margin-top: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .term-caret {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  import { site, type TermSegment } from '../data/site';
  import {
    commands,
    commandColumnWidth,
    resolveCommand,
    unknownCommandMessage
  } from '../data/commands';

  const terminal = document.getElementById('terminal');
  const output = document.getElementById('term-output');
  const form = document.getElementById('term-form') as HTMLFormElement | null;
  const input = document.getElementById('term-input') as HTMLInputElement | null;
  const toggle = document.getElementById('term-toggle') as HTMLButtonElement | null;

  if (!terminal || !output || !form || !input) {
    // 理论上不会发生；直接保持静态输出即可
  } else {
    const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const isReduced = () => reducedQuery.matches;
    const sleep = (ms: number) => new Promise<void>((resolve) => window.setTimeout(resolve, ms));

    let taskQueue: Promise<void> = Promise.resolve();

    const enqueue = (task: () => Promise<void> | void) => {
      taskQueue = taskQueue.then(task).catch(() => undefined);
    };

    const scrollOutput = () => {
      output.scrollTop = output.scrollHeight;
    };

    const makeSegment = (text: string, tone?: string) => {
      const span = document.createElement('span');
      span.className = 'seg' + (tone ? ` seg-${tone}` : '');
      span.textContent = text;
      return span;
    };

    const appendGap = () => {
      const line = document.createElement('div');
      line.className = 'line line-gap';
      line.setAttribute('aria-hidden', 'true');
      output.appendChild(line);
      scrollOutput();
    };

    /** 逐字打出若干行，长文本或减少动态偏好时整行出现 */
    const typeLines = async (lines: TermSegment[][]) => {
      for (const segments of lines) {
        const line = document.createElement('div');
        line.className = 'line line-out';
        output.appendChild(line);

        const total = segments.reduce((sum, s) => sum + s.text.length, 0);
        if (isReduced() || total > 96) {
          segments.forEach((s) => line.appendChild(makeSegment(s.text, s.tone)));
        } else {
          output.setAttribute('aria-busy', 'true');
          for (const s of segments) {
            const span = makeSegment('', s.tone);
            line.appendChild(span);
            for (const char of s.text) {
              span.textContent += char;
              scrollOutput();
              await sleep(char === ' ' ? 4 : 11);
            }
          }
          output.setAttribute('aria-busy', 'false');
        }
        scrollOutput();
        await sleep(isReduced() ? 0 : 38);
      }
    };

    const echo = (command: string) => {
      const line = document.createElement('div');
      line.className = 'line line-cmd';
      const prompt = document.createElement('span');
      prompt.className = 'ps1';
      prompt.textContent = `${site.promptUser}@${site.promptHost}:~$`;
      const text = document.createElement('span');
      text.className = 'cmd-text';
      text.textContent = command;
      line.append(prompt, text);
      output.appendChild(line);
      scrollOutput();
      return sleep(isReduced() ? 0 : 70);
    };

    const scrollToSection = (hash: string) => {
      const target = document.querySelector<HTMLElement>(hash);
      if (!target) return;
      target.scrollIntoView({ behavior: isReduced() ? 'auto' : 'smooth', block: 'start' });
    };

    const copyEmail = async () => {
      try {
        if (!navigator.clipboard?.writeText) throw new Error('clipboard unavailable');
        await navigator.clipboard.writeText(site.email);
        await typeLines([
          [
            { text: '✓ ', tone: 'green' },
            { text: '邮箱已复制：', tone: 'muted' },
            { text: site.email, tone: 'cyan' }
          ]
        ]);
      } catch {
        await typeLines([
          [{ text: '复制失败，请手动复制：', tone: 'muted' }],
          [{ text: site.email, tone: 'cyan' }]
        ]);
      }
    };

    const helpLines = (): TermSegment[][] => {
      const lines: TermSegment[][] = [[{ text: '可用命令：', tone: 'muted' }]];
      for (const command of commands) {
        lines.push([
          { text: `  ${command.name.padEnd(commandColumnWidth + 2)}`, tone: 'cyan' },
          { text: command.description, tone: 'muted' }
        ]);
      }
      lines.push([{ text: '提示：↑ / ↓ 翻历史，Esc 清屏。', tone: 'dim' }]);
      return lines;
    };

    const lsSegments = (): TermSegment[] => [
      { text: 'about/', tone: 'cyan' },
      { text: '  ', tone: 'dim' },
      { text: 'projects/', tone: 'cyan' },
      { text: '  ', tone: 'dim' },
      { text: 'writing/', tone: 'cyan' },
      { text: '  ', tone: 'dim' },
      { text: 'contact/', tone: 'cyan' },
      { text: '  ', tone: 'dim' },
      { text: 'spark.sh', tone: 'accent' }
    ];

    const randomSpark = () => site.sparks[Math.floor(Math.random() * site.sparks.length)];

    const actions: Record<string, () => Promise<void> | void> = {
      help: async () => {
        await typeLines(helpLines());
      },
      whoami: async () => {
        await typeLines([
          [
            { text: 'Jrxh', tone: 'text' },
            { text: ' — 独立开发者 / 全栈 / 工具爱好者', tone: 'muted' }
          ],
          [{ text: '↓ 正在打开：关于我', tone: 'dim' }]
        ]);
        scrollToSection('#about');
      },
      list: async () => {
        await typeLines([lsSegments()]);
      },
      projects: async () => {
        await typeLines([
          [{ text: 'projects/', tone: 'cyan' }, { text: ' → 2 个精选项目', tone: 'muted' }],
          [{ text: '↓ 正在打开项目区', tone: 'dim' }]
        ]);
        scrollToSection('#projects');
      },
      motto: async () => {
        await typeLines([[{ text: site.motto, tone: 'accent' }]]);
      },
      spark: async () => {
        spawnParticles(26, 'terminal', 800);
        await typeLines([
          [{ text: '✦ ', tone: 'accent' }, { text: randomSpark(), tone: 'text' }],
          [{ text: '火花已点燃。', tone: 'dim' }]
        ]);
      },
      contact: copyEmail,
      clear: async () => {
        output.replaceChildren();
      }
    };

    let history: string[] = [];
    let historyIndex = 0;

    const run = (raw: string) => {
      const value = raw.trim();
      if (!value) return;

      history = [...history.filter((item) => item !== value), value];
      historyIndex = history.length;

      const spec = resolveCommand(value);
      enqueue(async () => {
        await echo(value);
        if (!spec) {
          await typeLines([
            [
              { text: 'command not found: ', tone: 'muted' },
              { text: value, tone: 'accent' },
              { text: '. 试试输入 help.', tone: 'muted' }
            ]
          ]);
          return;
        }
        const action = actions[spec.action];
        if (action) await action();
      });
    };

    const syncEmptyState = () => {
      form.classList.toggle('is-empty', input.value.length === 0);
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      run(input.value);
      input.value = '';
      syncEmptyState();
    });

    input.addEventListener('input', syncEmptyState);

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowUp') {
        if (!history.length) return;
        event.preventDefault();
        historyIndex = Math.max(0, historyIndex - 1);
        input.value = history[historyIndex] ?? '';
        syncEmptyState();
      } else if (event.key === 'ArrowDown') {
        if (!history.length) return;
        event.preventDefault();
        historyIndex = Math.min(history.length, historyIndex + 1);
        input.value = history[historyIndex] ?? '';
        syncEmptyState();
      } else if (event.key === 'Escape') {
        event.preventDefault();
        output.replaceChildren();
        input.value = '';
        syncEmptyState();
      }
    });

    terminal.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
        '.quick-btn'
      );
      if (!target) return;
      const command = target.dataset.command ?? '';
      // 填充命令 -> 执行 -> 清空，保证输入框状态干净
      input.value = command;
      syncEmptyState();
      run(command);
      input.value = '';
      syncEmptyState();
      // 移动端不主动聚焦输入框，避免强制唤起键盘
      if (window.matchMedia('(min-width: 641px)').matches) {
        input.focus();
      }
    });

    if (toggle) {
      toggle.addEventListener('click', () => {
        const open = terminal.classList.toggle('input-open');
        toggle.setAttribute('aria-expanded', String(open));
        if (open) input.focus();
      });
    }

    // 页面其它位置（例如 Hero 的「运行 spark.sh」）可以请求终端执行命令
    window.addEventListener('jrxh:run', (event) => {
      const command = (event as CustomEvent<string>).detail;
      if (typeof command !== 'string' || !command.trim()) return;
      run(command);
      if (window.matchMedia('(min-width: 641px)').matches) {
        input.focus({ preventScroll: true });
      } else {
        terminal.scrollIntoView({ behavior: isReduced() ? 'auto' : 'smooth', block: 'center' });
      }
    });

    /* ---------- 星火粒子：纯 DOM + CSS，无动画库 ---------- */

    const spawnParticles = (count: number, scope: 'terminal' | 'viewport', life: number) => {
      if (isReduced()) return;

      const rect =
        scope === 'viewport'
          ? { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight }
          : terminal.getBoundingClientRect();

      const layer = document.createElement('div');
      layer.className = 'spark-layer';

      for (let i = 0; i < count; i += 1) {
        const particle = document.createElement('span');
        particle.className = 'spark-particle';
        const x = rect.left + Math.random() * rect.width;
        const y =
          rect.top +
          (scope === 'viewport'
            ? Math.random() * rect.height
            : rect.height * (0.4 + Math.random() * 0.55));
        particle.style.left = `${x}px`;
        particle.style.top = `${y}px`;
        particle.style.setProperty('--tx', `${(Math.random() - 0.5) * 180}px`);
        particle.style.setProperty('--ty', `${-(70 + Math.random() * 180)}px`);
        particle.style.setProperty('--size', `${2 + Math.random() * 3.4}px`);
        particle.style.setProperty('--life', `${Math.round(life * (0.62 + Math.random() * 0.3))}ms`);
        particle.style.setProperty(
          '--tint',
          Math.random() > 0.78 ? 'var(--cyan)' : 'var(--spark)'
        );
        layer.appendChild(particle);
      }

      document.body.appendChild(layer);
      window.setTimeout(() => layer.remove(), life + 200);
    };

    /* ---------- Konami code 彩蛋 ---------- */

    const konami = [
      'ArrowUp',
      'ArrowUp',
      'ArrowDown',
      'ArrowDown',
      'ArrowLeft',
      'ArrowRight',
      'ArrowLeft',
      'ArrowRight',
      'b',
      'a'
    ];
    let konamiIndex = 0;

    document.addEventListener('keydown', (event) => {
      const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
      if (key === konami[konamiIndex]) {
        konamiIndex += 1;
        if (konamiIndex === konami.length) {
          konamiIndex = 0;
          spawnParticles(48, 'viewport', 2000);
        }
      } else {
        konamiIndex = key === konami[0] ? 1 : 0;
      }
    });

    syncEmptyState();
  }
</script>
