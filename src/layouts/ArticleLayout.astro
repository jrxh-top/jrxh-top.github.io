---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeInit from '../components/ThemeInit.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  slug: string;
  date: Date;
}

const { title, description, slug, date } = Astro.props;
const pageTitle = `${title} — 写作 | jrxh.top`;
const canonical = `${site.url}/writing/${slug}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0c10" />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="jrxh.top" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta property="article:published_time" content={date.toISOString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/og.png`} />
    <meta name="twitter:image:alt" content={title} />

    <ThemeInit />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>

    <div class="shell page-shell">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: date.toISOString(),
      mainEntityOfPage: canonical,
      image: `${site.url}/og.png`,
      author: {
        '@type': 'Person',
        name: 'Jrxh',
        url: site.url
      }
    })} />
  </body>
</html>

<style>
  .page-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page-shell > main {
    flex: 1;
  }
</style>
