---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Terminal from '../components/Terminal.astro';
import Bento from '../components/Bento.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import ThemeInit from '../components/ThemeInit.astro';
import { site, projects } from '../data/site';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={site.url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0c10" />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="jrxh.top" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.url} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Jrxh Spark Console — jrxh.top" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={`${site.url}/og.png`} />
    <meta name="twitter:image:alt" content="Jrxh Spark Console — jrxh.top" />

    <ThemeInit />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>

    <div class="shell">
      <Header />

      <main id="main">
        <section class="hero" id="top" aria-labelledby="hero-title">
          <div class="container">
            <div class="sheet-meta" aria-hidden="true">
              <span>jrxh.top — spark console</span>
              <span>rev. 2026.11 · tty1</span>
            </div>

            <div class="hero-grid">
              <div class="hero-copy">
                <p class="hero-kicker" data-reveal>
                  <span class="kicker-mark" aria-hidden="true"></span>
                  {site.role}
                </p>

                <h1 class="hero-title" id="hero-title" data-reveal style="--reveal-delay: 60ms">
                  <span class="hero-line">{site.h1Lead}</span>
                  <span class="hero-line">
                    推到 <span class="hero-top">top<i class="hero-dot">.</i></span>
                  </span>
                </h1>

                <p class="hero-sub" data-reveal style="--reveal-delay: 120ms">{site.subtitle}</p>

                <div class="hero-actions" data-reveal style="--reveal-delay: 170ms">
                  <a class="btn btn-primary" href="#projects">
                    查看项目
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                  <button class="btn btn-ghost" type="button" data-run-command="./spark.sh">
                    <span class="ps1" aria-hidden="true">$</span>
                    运行 spark.sh
                  </button>
                </div>
              </div>

              <div class="hero-terminal" data-reveal style="--reveal-delay: 140ms">
                <div class="fig-head" aria-hidden="true">
                  <span class="fig-no">fig. 01</span>
                  <span class="fig-line"></span>
                  <span class="fig-name">spark console / live</span>
                </div>
                <Terminal />
                <p class="term-hint">
                  试试快捷命令，或者输入 <code>help</code>
                </p>
              </div>

              <dl class="hero-facts" data-reveal style="--reveal-delay: 220ms">
                <div class="fact">
                  <dt>status</dt>
                  <dd>{site.status}</dd>
                </div>
                <div class="fact">
                  <dt>principle</dt>
                  <dd>{site.motto}</dd>
                </div>
                <div class="fact">
                  <dt>mail</dt>
                  <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
                </div>
              </dl>
            </div>

            <ul class="hero-ticker" aria-hidden="true">
              <li>spark console</li>
              <li>tty1 / 80×24</li>
              <li>0 frameworks</li>
              <li>jrxh@top:~$ _</li>
            </ul>
          </div>
        </section>

        <Bento />

        <section class="section" id="projects" aria-labelledby="projects-title">
          <div class="container">
            <div class="section-head" data-reveal>
              <span class="section-index">02</span>
              <h2 class="section-title" id="projects-title">精选项目</h2>
              <span class="section-note">只放两个 · 都在推进</span>
            </div>

            <div class="project-list">
              {
                projects.map((project, i) => (
                  <ProjectCard project={project} delay={i * 70} />
                ))
              }
            </div>

            <p class="projects-foot" data-reveal>
              更多实验还在 <a href={site.links.github}>GitHub</a>，成熟一个放一个。
            </p>
          </div>
        </section>
      </main>

      <Footer />
    </div>

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Jrxh',
      url: site.url,
      email: site.email,
      image: `${site.url}/og.png`,
      jobTitle: '独立开发者',
      description: site.description,
      knowsAbout: ['TypeScript', 'React', 'Node', 'Python', 'PostgreSQL', 'Docker']
    })} />

    <script>
      // 滚动淡入
      const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' }
        );

        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }

      // Hero 的「运行 spark.sh」按钮 -> 交给终端执行
      document.querySelector<HTMLButtonElement>('[data-run-command]')?.addEventListener(
        'click',
        (event) => {
          const command = (event.currentTarget as HTMLButtonElement).dataset.runCommand ?? '';
          window.dispatchEvent(new CustomEvent('jrxh:run', { detail: command }));
        }
      );
    </script>

    <style>
      .hero {
        position: relative;
        padding-top: clamp(20px, 3vw, 32px);
        padding-bottom: clamp(32px, 4vw, 48px);
      }

      /* 图纸页眉：左站点名，右版本号 */
      .sheet-meta {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--hairline);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--faint);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
        grid-template-areas:
          'copy terminal'
          'facts terminal';
        align-items: start;
        column-gap: clamp(32px, 5vw, 72px);
        row-gap: 22px;
        padding-top: clamp(36px, 5.4vw, 72px);
      }

      .hero-copy {
        grid-area: copy;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 22px;
      }

      .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .kicker-mark {
        width: 6px;
        height: 6px;
        background: var(--spark);
      }

      .hero-title {
        font-family: var(--font-display);
        font-size: clamp(2.9rem, 6.4vw, 5.4rem);
        font-weight: 600;
        line-height: 1.06;
        letter-spacing: 0.02em;
        text-wrap: balance;
      }

      .hero-line {
        display: block;
      }

      .hero-top {
        font-family: var(--font-mono);
        font-size: 0.82em;
        letter-spacing: -0.05em;
        color: var(--spark);
      }

      .hero-dot {
        font-style: normal;
        color: var(--spark);
      }

      .hero-sub {
        max-width: 38em;
        font-size: clamp(0.95rem, 1.05vw, 1rem);
        line-height: 1.95;
        color: var(--muted);
        text-wrap: pretty;
      }

      .hero-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
      }

      /* 三格小档案：状态 / 原则 / 邮箱 */
      .hero-facts {
        grid-area: facts;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        width: 100%;
        margin: 0;
        border-top: 1px solid var(--hairline-soft);
      }

      .fact {
        padding: 14px 16px 0 0;
      }

      .fact + .fact {
        padding-left: 18px;
        border-left: 1px solid var(--hairline-soft);
      }

      .fact dt {
        margin-bottom: 5px;
        font-family: var(--font-mono);
        font-size: 9.5px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--faint);
      }

      .fact dd {
        margin: 0;
        font-size: 12.5px;
        line-height: 1.7;
        color: var(--text-soft-2);
      }

      .fact a {
        color: var(--text-soft);
        border-bottom: 1px solid transparent;
        transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
      }

      .fact a:hover {
        color: var(--spark);
        border-color: var(--spark-line);
      }

      .hero-terminal {
        grid-area: terminal;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding-top: clamp(4px, 2.4vw, 30px);
      }

      .fig-head {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: var(--font-mono);
        font-size: 9.5px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--faint);
      }

      .fig-no {
        color: var(--spark);
      }

      .fig-line {
        flex: 1 1 auto;
        height: 1px;
        background: var(--hairline-soft);
      }

      .term-hint {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.04em;
        color: var(--faint);
        padding-left: 2px;
      }

      .term-hint code {
        padding: 1px 5px;
        border: 1px solid var(--hairline-soft);
        border-radius: var(--radius);
        color: var(--muted);
        font-size: 10px;
      }

      /* 页脚式状态条：四条等宽信息 */
      .hero-ticker {
        display: flex;
        flex-wrap: wrap;
        margin-top: clamp(36px, 5vw, 60px);
        border-top: 1px solid var(--hairline);
        border-bottom: 1px solid var(--hairline-soft);
      }

      .hero-ticker li {
        flex: 1 1 auto;
        padding: 11px 18px;
        border-left: 1px solid var(--hairline-soft);
        font-family: var(--font-mono);
        font-size: 9.5px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--faint);
        white-space: nowrap;
      }

      .hero-ticker li:first-child {
        padding-left: 0;
        border-left: 0;
        color: var(--muted);
      }

      .hero-ticker li:last-child {
        padding-right: 0;
        text-align: right;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: none;
        font-size: 10.5px;
      }

      .project-list {
        display: flex;
        flex-direction: column;
      }

      .projects-foot {
        margin-top: 20px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.04em;
        color: var(--faint);
      }

      .projects-foot a {
        color: var(--muted);
        border-bottom: 1px solid var(--mark-line);
        transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
      }

      .projects-foot a:hover {
        color: var(--spark);
        border-color: var(--spark-line);
      }

      @media (max-width: 980px) {
        .hero-grid {
          grid-template-columns: minmax(0, 1fr);
          grid-template-areas:
            'copy'
            'terminal'
            'facts';
          gap: 40px;
          padding-top: 40px;
        }

        .hero-facts {
          grid-template-columns: minmax(0, 1fr);
          border-top: 0;
        }

        .fact {
          padding: 12px 0;
          border-top: 1px solid var(--hairline-soft);
        }

        .fact:first-child {
          padding-top: 6px;
        }

        .fact + .fact {
          padding-left: 0;
          border-left: 0;
        }
      }

      @media (max-width: 640px) {
        .sheet-meta {
          font-size: 9px;
          letter-spacing: 0.1em;
        }

        .hero-title {
          font-size: clamp(2.4rem, 11vw, 3.4rem);
        }

        .hero-actions {
          width: 100%;
        }

        .hero-actions .btn {
          flex: 1 1 auto;
        }

        .hero-ticker {
          margin-top: 34px;
        }

        .hero-ticker li {
          flex: 0 0 50%;
          border-top: 1px solid var(--hairline-soft);
          padding: 9px 12px;
        }

        .hero-ticker li:nth-child(odd) {
          border-left: 0;
          padding-left: 0;
        }

        .hero-ticker li:nth-child(-n + 2) {
          border-top: 0;
        }

        .hero-ticker li:last-child {
          text-align: left;
        }
      }
    </style>
  </body>
</html>
