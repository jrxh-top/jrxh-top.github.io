---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeInit from '../components/ThemeInit.astro';
import { site } from '../data/site';

const spark = site.sparks[Math.floor(Math.random() * site.sparks.length)];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>spark.sh — 随机一点火花 | jrxh.top</title>
    <meta name="description" content="每次打开都换一句灵感，来自 Jrxh 的星火控制台。" />
    <link rel="canonical" href={`${site.url}/spark`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0c10" />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="spark.sh — 随机一点火花" />
    <meta property="og:description" content="每次打开都换一句灵感，来自 Jrxh 的星火控制台。" />
    <meta property="og:url" content={`${site.url}/spark`} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Jrxh Spark Console — jrxh.top" />

    <ThemeInit />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>

    <div class="shell page-shell">
      <Header />

      <main id="main" class="spark-main">
        <div class="container spark-inner">
          <p class="spark-eyebrow">
            <span class="spark-mark" aria-hidden="true">✦</span>
            ./spark.sh — 每次打开都不一样
          </p>

          <blockquote class="spark-quote">
            <p id="spark-text">{spark}</p>
          </blockquote>

          <p class="spark-source">— 星火控制台，第 <span id="spark-count">1</span> 次点火</p>

          <div class="spark-actions">
            <button class="btn btn-primary" type="button" id="respark">
              再来一句
              <span class="arrow" aria-hidden="true">✦</span>
            </button>
            <a class="btn btn-ghost" href="/">
              <span class="ps1" aria-hidden="true">$</span>
              回到控制台
            </a>
          </div>
        </div>
      </main>

      <Footer />
    </div>

    <script>
      import { site } from '../data/site';

      const textEl = document.getElementById('spark-text');
      const countEl = document.getElementById('spark-count');
      const button = document.getElementById('respark');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      let count = 1;

      const pickAnother = (from: string) => {
        let pick = from;
        while (pick === from) {
          pick = site.sparks[Math.floor(Math.random() * site.sparks.length)];
        }
        return pick;
      };

      // 首次进入随机一次，避免每次都看到构建时抽到的那句
      if (textEl && site.sparks.length > 1) {
        textEl.textContent = pickAnother(textEl.textContent ?? '');
      }

      button?.addEventListener('click', () => {
        if (!textEl) return;
        textEl.textContent = pickAnother(textEl.textContent ?? '');
        count += 1;
        if (countEl) countEl.textContent = String(count);
        if (!reduced.matches) {
          textEl.animate?.(
            [
              { opacity: 0.15, transform: 'translateY(6px)' },
              { opacity: 1, transform: 'none' }
            ],
            { duration: 420, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' }
          );
        }
      });
    </script>

    <style>
      .page-shell {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .spark-main {
        flex: 1;
        display: flex;
        align-items: center;
        padding-block: clamp(56px, 9vw, 104px);
      }

      .spark-inner {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 22px;
        max-width: 760px;
      }

      .spark-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        color: var(--dim);
      }

      .spark-mark {
        color: var(--spark);
        font-size: 13px;
        animation: spark-pulse 2.8s var(--ease) infinite;
      }

      @keyframes spark-pulse {
        0%,
        100% {
          opacity: 0.55;
          transform: scale(0.9);
        }
        50% {
          opacity: 1;
          transform: scale(1.1);
        }
      }

      .spark-quote {
        margin: 0;
        padding-left: clamp(18px, 3vw, 28px);
        border-left: 2px solid var(--spark);
      }

      .spark-quote p {
        font-family: var(--font-display);
        font-size: clamp(1.85rem, 4.6vw, 3.1rem);
        font-weight: 600;
        line-height: 1.48;
        letter-spacing: 0.02em;
        color: var(--text);
        text-wrap: balance;
      }

      .spark-source {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.08em;
        color: var(--faint);
      }

      .spark-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 6px;
      }

      @media (prefers-reduced-motion: reduce) {
        .spark-mark {
          animation: none;
          opacity: 1;
        }
      }
    </style>
  </body>
</html>
