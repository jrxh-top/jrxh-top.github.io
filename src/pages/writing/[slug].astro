---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = (
    await getCollection('writing', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
  ).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      number: String(posts.length - i).padStart(2, '0'),
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null
    }
  }));
}

interface Props {
  post: CollectionEntry<'writing'>;
  number: string;
  newer: CollectionEntry<'writing'> | null;
  older: CollectionEntry<'writing'> | null;
}

const { post, number, newer, older } = Astro.props as Props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(
    date.getDate()
  ).padStart(2, '0')}`;

const readMinutes = (body: string | undefined) =>
  Math.max(1, Math.round((body?.replace(/\s/g, '').length ?? 0) / 300));

const readTime = readMinutes(post.body);
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  slug={post.id}
  date={post.data.date}
>
  <section class="article-section">
    <div class="container">
      <nav class="crumbs" aria-label="面包屑">
        <a href="/writing/">写作 / notes</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{post.id}</span>
      </nav>

      <header class="article-head">
        <p class="article-kicker">field note · no. {number}</p>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-desc">{post.data.description}</p>

        <div class="article-meta">
          <span>{formatDate(post.data.date)}</span>
          <span>{readTime} min read</span>
          {
            post.data.tags.length > 0 && (
              <ul class="article-tags" aria-label="标签">
                {post.data.tags.map((tag) => (
                  <li>#{tag}</li>
                ))}
              </ul>
            )
          }
        </div>
      </header>

      <article class="prose">
        <Content />
      </article>

      <nav class="article-nav" aria-label="文章导航">
        <a class="back-link" href="/writing/">← 全部写作</a>

        <div class="nav-pair">
          {
            older && (
              <a href={`/writing/${older.id}/`}>
                <span>上一篇</span>
                <strong>{older.data.title}</strong>
              </a>
            )
          }
          {
            newer && (
              <a href={`/writing/${newer.id}/`}>
                <span>下一篇</span>
                <strong>{newer.data.title}</strong>
              </a>
            )
          }
        </div>
      </nav>
    </div>
  </section>
</ArticleLayout>

<style>
  .article-section {
    padding-block: clamp(24px, 3.4vw, 36px) clamp(44px, 6vw, 72px);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: clamp(22px, 3vw, 34px);
    border-bottom: 1px solid var(--hairline-soft);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .crumbs a {
    transition: color 0.2s var(--ease);
  }

  .crumbs a:hover {
    color: var(--spark);
  }

  .article-head {
    padding-top: clamp(30px, 4.4vw, 54px);
  }

  .article-kicker {
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--spark);
  }

  .article-title {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  .article-desc {
    max-width: 36em;
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.9;
    color: var(--muted);
    text-wrap: pretty;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    margin-top: clamp(20px, 3vw, 30px);
    padding-top: 14px;
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-left: auto;
    color: var(--dim);
  }

  .prose {
    max-width: 720px;
    padding-block: clamp(30px, 4vw, 44px) clamp(40px, 6vw, 64px);
    font-size: 16.5px;
    line-height: 2;
    color: var(--prose-text);
  }

  .prose :global(p) {
    margin: 0 0 1.3em;
  }

  .prose :global(h2) {
    margin: 2.2em 0 0.8em;
    padding-top: 1em;
    border-top: 1px solid var(--hairline-soft);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.015em;
    color: var(--text);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .prose :global(h3) {
    margin: 1.8em 0 0.6em;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text);
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(em) {
    font-style: normal;
    color: var(--spark);
  }

  .prose :global(a) {
    color: var(--text);
    border-bottom: 1px solid var(--spark-line);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .prose :global(a:hover) {
    color: var(--spark);
    border-color: var(--spark);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.4em;
    padding-left: 1.25em;
  }

  .prose :global(li) {
    margin-bottom: 0.45em;
  }

  .prose :global(li)::marker {
    color: var(--spark);
  }

  .prose :global(blockquote) {
    margin: 1.9em 0;
    padding: 0.1em 0 0.1em 20px;
    border-left: 2px solid var(--spark);
    font-family: var(--font-display);
    font-size: 1.16em;
    line-height: 1.75;
    letter-spacing: 0.015em;
    color: var(--text);
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  .prose :global(code) {
    padding: 2px 5px;
    border: 1px solid var(--hairline-soft);
    background: var(--code-inline-bg);
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--code-inline-text);
  }

  .prose :global(:not(pre) > code) {
    white-space: nowrap;
  }

  .prose :global(pre) {
    margin: 1.6em 0;
    padding: 16px 18px;
    border: 1px solid var(--hairline);
    background: var(--code-bg);
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.8;
  }

  .prose :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
    color: var(--code-text);
  }

  .prose :global(hr) {
    margin: 2.4em 0;
    border: 0;
    border-top: 1px solid var(--hairline);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
  }

  .article-nav {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }

  .back-link:hover {
    color: var(--spark);
  }

  .nav-pair {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-left: auto;
  }

  .nav-pair a {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 260px;
  }

  .nav-pair span {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .nav-pair strong {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
    transition: color 0.2s var(--ease);
  }

  .nav-pair a:hover strong {
    color: var(--spark);
  }

  @media (max-width: 640px) {
    .article-title {
      max-width: none;
    }

    .article-tags {
      margin-left: 0;
    }

    .prose {
      font-size: 16px;
      line-height: 1.95;
    }

    .prose :global(pre) {
      padding: 14px;
      font-size: 12px;
    }

    .nav-pair {
      width: 100%;
      margin-left: 0;
      gap: 20px;
    }

    .nav-pair a {
      max-width: none;
    }
  }
</style>
