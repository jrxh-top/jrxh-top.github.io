---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ThemeInit from '../../components/ThemeInit.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(
    date.getDate()
  ).padStart(2, '0')}`;

const readMinutes = (body: string | undefined) =>
  Math.max(1, Math.round((body?.replace(/\s/g, '').length ?? 0) / 300));

const title = '写作 / 笔记 — Jrxh | jrxh.top';
const description = 'Jrxh 的写作与笔记：工程习惯、工具取舍、产品想法。';
const canonical = `${site.url}/writing/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0c10" />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="jrxh.top" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Jrxh Spark Console — jrxh.top" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/og.png`} />
    <meta name="twitter:image:alt" content="Jrxh Spark Console — jrxh.top" />

    <ThemeInit />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>

    <div class="shell page-shell">
      <Header />

      <main id="main">
        <section class="section writing-section" aria-labelledby="writing-title">
          <div class="container">
            <div class="section-head" data-reveal>
              <span class="section-index">03</span>
              <h1 class="section-title" id="writing-title">写作 / 笔记</h1>
              <span class="section-note">{posts.length} 篇 · 持续更新</span>
            </div>

            <p class="writing-intro" data-reveal>
              把想清楚的事写下来。短的、具体的、能复用的。
            </p>

            <div class="note-list">
              {
                posts.map((post, i) => (
                  <a
                    class="note-row"
                    href={`/writing/${post.id}/`}
                    data-reveal
                    style={`--reveal-delay: ${i * 60}ms`}
                  >
                    <span class="note-date">{formatDate(post.data.date)}</span>
                    <span class="note-main">
                      <span class="note-title">{post.data.title}</span>
                      <span class="note-desc">{post.data.description}</span>
                    </span>
                    <span class="note-meta">
                      {readMinutes(post.body)} min read
                      <span class="note-arrow" aria-hidden="true">↗</span>
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
        </section>
      </main>

      <Footer />
    </div>

    <script>
      const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' }
        );

        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style>
  .page-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page-shell > main {
    flex: 1;
  }

  .writing-section {
    border-top: 0;
    padding-top: clamp(36px, 5vw, 56px);
  }

  .writing-intro {
    max-width: 34em;
    margin-bottom: clamp(30px, 4vw, 46px);
    font-size: 15px;
    line-height: 1.9;
    color: var(--muted);
  }

  .note-list {
    display: flex;
    flex-direction: column;
  }

  .note-row {
    position: relative;
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    grid-template-areas: 'date main meta';
    align-items: start;
    gap: 12px 28px;
    padding: 26px 12px 28px;
    margin-inline: -12px;
    border-top: 1px solid var(--hairline-soft);
    transition: background-color 0.3s var(--ease);
  }

  .note-row:last-child {
    border-bottom: 1px solid var(--hairline-soft);
  }

  .note-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--spark);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.3s var(--ease);
  }

  .note-row:hover {
    background: var(--hover-row);
  }

  .note-row:hover::before {
    transform: scaleY(1);
  }

  .note-date {
    grid-area: date;
    padding-top: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  .note-main {
    grid-area: main;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .note-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.015em;
    transition: color 0.2s var(--ease);
  }

  .note-row:hover .note-title {
    color: var(--spark);
  }

  .note-desc {
    max-width: 46em;
    font-size: 13px;
    line-height: 1.85;
    color: var(--muted);
    text-wrap: pretty;
  }

  .note-meta {
    grid-area: meta;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-top: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }

  .note-arrow {
    font-size: 12px;
    color: var(--dim);
    transition: transform 0.2s var(--ease), color 0.2s var(--ease);
  }

  .note-row:hover .note-arrow {
    color: var(--spark);
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .note-row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'date meta'
        'main main';
      gap: 8px 16px;
      padding: 22px 0 24px;
      margin-inline: 0;
    }

    .note-date,
    .note-meta {
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-row::before {
      transition: none;
    }
  }
</style>
